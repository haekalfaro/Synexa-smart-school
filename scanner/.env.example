# Harus SAMA dengan SCANNER_KEY di .env Laravel
VITE_SCANNER_KEY=ganti-dengan-kunci-rahasia
# Nama gerbang yang dicatat di tabel kehadiran
# Nama perangkat yang tampil di Status Perangkat Gerbang (dashboard admin)
VITE_DEVICE_NAME=Scanner 1
VITE_GATE_NAME=Gerbang Utama
# Hanya untuk tampilan. Aturan sebenarnya diatur server (SCHOOL_BATAS_MASUK).
VITE_BATAS_MASUK=07:30
